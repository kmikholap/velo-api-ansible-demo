# Example edge definitions — copy to edges.yml and customize
# cp edges.yml.example edges.yml

# Default profile and model for all edges (can be overridden per-edge)
vco_default_profile_name: "Quick Start Profile"
vco_default_model: "edge6X0"

# List of edges to provision — each edge gets its own WAN IP configuration
edges_to_provision:
  - name: "SITE-EDGE-01"
    model_number: "edge7X0"
    profile_name: "Branch"
    description: "Branch Office 1"
    site:
      contactName: "Network Admin"
      contactEmail: "admin@example.com"
      streetAddress: "100 Main Street"
      city: "Your City"
      state: "ST"
      country: "US"
      postalCode: "00000"
    wan_interface: "GE3"
    wan_ip: "203.0.113.10"
    wan_netmask: "255.255.255.248"
    wan_gateway: "203.0.113.9"
    send_activation_email: true
    license_alias: "POC"
    ha_enabled: false

  - name: "SITE-EDGE-02"
    model_number: "virtual"
    description: "Virtual Edge (Lab)"
    site:
      contactName: "Lab Admin"
      contactEmail: "lab@example.com"
      city: "Your City"
      state: "ST"
      country: "US"
    wan_ip: "10.200.1.10"
    wan_netmask: "255.255.255.0"
    wan_gateway: "10.200.1.1"
    send_activation_email: true
    license_alias: "POC"
    ha_enabled: false
